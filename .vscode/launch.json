    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Flutter Web (Chrome)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            "toolArgs": [
                "--web-port=5000",
                "--dart-define=API_BASE_URL=http://localhost:8080"
            ]
        }
    ]
}